# Copy this file to .env.local and fill in values locally.
# Never commit .env.local or paste secrets into chat.
# This is Garmin's Personal API key, not the short-lived Bearer token.
GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com
GARMIN_PERSONAL_API_KEY=

# Optional directory of an existing local Garmin Connect session (default: %USERPROFILE%\\.garminconnect).
# The session stays on the server and is used read-only for Training Status, Load Focus,
# Running Tolerance and Endurance Score.
GARMIN_CONNECT_TOKEN_PATH=

# Optional: private Runna iCalendar URL for upcoming planned runs.
# Runna → Profile → Connected Apps & Devices → Calendars → Other Calendar.
RUNNA_ICAL_URL=

# Optional fixed override in minutes; leave blank to use Garmin's Sleep Need.
GARMIN_SLEEP_TARGET_MINUTES=

# Optional AI reading of uploaded lab PDFs. Keep the key only in .env/.env.local.
# PDF analysis sends the document to OpenAI only after confirmation in the dashboard.
OPENAI_API_KEY=
OPENAI_LAB_MODEL=gpt-6-luna

# Existing local alias is also accepted during migration:
# GARMIN_API_TOKEN=

# Optional nutrition food provider (manual food entry works without it).
USDA_API_KEY=
# Optional recipe model override; empty uses the configured laboratory model.
NUTRITION_AI_MODEL=
